exports[`TwoFactorChallengeForm > passkeys > offers the passkey first, then the code, with both 1`] = `
"<div data-v-aadd5ba7="" class="card">
  <div data-v-aadd5ba7="" class="card-body">
    <form data-v-aadd5ba7="" role="form" method="POST" action="/admin/two-factor/challenge" novalidate="">
      <div data-v-aadd5ba7="" class="auth-header">
        <h1 data-v-aadd5ba7="" class="auth-title">Two-factor authentication</h1>
        <p data-v-aadd5ba7="" class="auth-subtitle">Use your passkey or enter the code.</p>
      </div>
      <div data-v-aadd5ba7="" class="auth-body">
        <div data-v-aadd5ba7="" class="mb-3 passkey-option"><button data-v-aadd5ba7="" type="button" class="btn btn-primary w-100 passkey-btn"><i data-v-aadd5ba7="" class="fa fa-fingerprint"></i> Use a passkey</button>
          <!--v-if-->
          <p data-v-aadd5ba7="" class="text-center text-body-secondary mt-3 mb-0 passkey-or">or</p>
        </div>
        <div data-v-aadd5ba7="" class="mb-3"><label data-v-aadd5ba7="" for="code">Code</label>
          <div data-v-aadd5ba7="" class="input-group input-group--custom"><span data-v-aadd5ba7="" class="input-group-text"><i data-v-aadd5ba7="" class="fa fa-mobile-screen"></i></span><input data-v-aadd5ba7="" id="code" type="text" class="form-control" name="code" autocomplete="one-time-code" inputmode="numeric" placeholder="Code"></div>
          <!--v-if-->
        </div>
        <div data-v-aadd5ba7="" class="mb-3"><button data-v-aadd5ba7="" type="submit" class="btn btn-primary submit-btn">
            <!--v-if--> Verify
          </button></div>
        <div data-v-aadd5ba7="" class="mb-3 text-center"><button data-v-aadd5ba7="" type="button" class="btn btn-link auth-ghost-link toggle-link">Use a recovery code</button></div>
      </div>
    </form>
  </div>
</div>"
`;

