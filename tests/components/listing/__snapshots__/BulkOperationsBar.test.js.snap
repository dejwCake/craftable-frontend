// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`BulkOperationsBar > renders only the buttons whose handlers are given 1`] = `
"<span class="align-middle fw-light text-dark">Selected items 3. <a href="javascript:void(0)" class="text-primary"><!--v-if--> Check all items 10</a><span class="text-primary"> | </span><a href="javascript:void(0)" class="text-primary">Uncheck all items</a></span>
<span class="float-end pe-2"><span class="d-inline-flex gap-2"><!--v-if--><button class="btn btn-sm btn-dark px-4"><i class="fa fa-eraser me-1"></i> Delete permanently</button><button class="btn btn-sm btn-success text-white px-4"><i class="fa fa-trash-arrow-up me-1"></i> Restore</button></span></span>"
`;

exports[`BulkOperationsBar > renders with selected count 1`] = `
"<span class="align-middle fw-light text-dark">Selected items 3. <a href="javascript:void(0)" class="text-primary"><!--v-if--> Check all items 10</a><span class="text-primary"> | </span><a href="javascript:void(0)" class="text-primary">Uncheck all items</a></span>
<span class="float-end pe-2"><span class="d-inline-flex gap-2"><button class="btn btn-sm btn-danger px-4"><i class="fa fa-trash me-1"></i> Delete</button><!--v-if--><!--v-if--></span></span>"
`;
