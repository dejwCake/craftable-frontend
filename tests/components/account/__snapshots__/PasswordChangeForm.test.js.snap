// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`PasswordChangeForm > renders the password change form 1`] = `
"<form class="form-horizontal" method="post" action="/admin/password" novalidate="">
  <div class="card">
    <div class="card-header"><i class="fa fa-pencil"></i> Change password</div>
    <div class="card-body">
      <div class="mb-3 row align-items-center"><label for="current_password" class="col-md-3 col-form-label text-md-end">Current password</label>
        <div class="col-md-9 col-xl-8"><input id="current_password" type="password" class="form-control" name="current_password" placeholder="Current password" value="">
          <!--v-if-->
        </div>
      </div>
      <div class="mb-3 row align-items-center"><label for="password" class="col-md-3 col-form-label text-md-end">New password</label>
        <div class="col-md-9 col-xl-8"><input id="password" type="password" class="form-control" name="password" placeholder="New password" value="">
          <!--v-if-->
        </div>
      </div>
      <div class="mb-3 row align-items-center"><label for="password_confirmation" class="col-md-3 col-form-label text-md-end">Repeat new password</label>
        <div class="col-md-9 col-xl-8"><input id="password_confirmation" type="password" class="form-control" name="password_confirmation" placeholder="New password" value="">
          <!--v-if-->
        </div>
      </div>
    </div>
    <div class="card-footer"><button type="submit" class="btn btn-primary submit-btn"><i class="fa fa-download"></i> Save</button></div>
  </div>
</form>"
`;
